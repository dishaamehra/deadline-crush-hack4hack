APP_DOMAIN=staging.example.org
STORAGE_DOMAIN=storage-staging.example.org
PORT=4000
S3_REGION=us-east-1
S3_BUCKET=deadline
S3_CONFIGURE_BUCKET_CORS=false
S3_ACCESS_KEY=replace-with-a-unique-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=Deadline Crush <verified-sender@example.org>
DEMO_PASSWORD=replace-with-a-long-private-password
